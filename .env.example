# NextAuth secret, generate with `npx auth secret` or `openssl rand -base64 33`
AUTH_SECRET=

# Postgres connection string (Puck page content, RAG knowledge base)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dnet_compro

# Cloudflare R2 (Puck editor image uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Public URL of this app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# First Admin account, created by `prisma migrate` seed (prisma/seed.ts) if no
# Admin exists yet. Only read once at seed time — safe to unset afterwards.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
